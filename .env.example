# Copy this file to .env and fill in real values before running
# `podman compose up` or `pnpm dev`.

# --- PostgreSQL (self-hosted container) ---
POSTGRES_USER=memgrow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memgrow
# Host-facing port for the db container (compose binds it to 127.0.0.1 only).
POSTGRES_PORT=5432

# Host-facing connection string used by `pnpm dev`, scripts/db.backup.sh,
# scripts/db.restore.sh, and scripts/db.seed.ts. Must use `localhost`, not
# the container hostname `db` (compose overrides this to `db:5432` for the
# app container itself).
POSTGRES_URL=postgresql://memgrow:change-me@localhost:5432/memgrow

# Set to `pg` for self-hosting (plain Postgres). Leave unset (defaults to
# `neon`) when deploying to Vercel against a Neon database.
DB_PROVIDER=pg

# --- App ---
# Host-facing port for the app container.
APP_PORT=3000

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL this instance is reached at, e.g. http://your-host:3000
AUTH_URL=http://localhost:3000
# Required when running behind a reverse proxy or on a LAN/VPN address that
# doesn't match AUTH_URL exactly.
AUTH_TRUST_HOST=true

# --- Optional integrations (leave blank to disable the related feature) ---
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# IMAGE_PROVIDER=bedrock
# LLM_MODEL=imagen-4.0-generate-001
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# VERTEXAI_PROJECT=
# VERTEXAI_LOCATION=us-central1
# VERTEXAI_ACCESS_TOKEN=
