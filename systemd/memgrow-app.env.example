# Copy to memgrow-app.env (next to this file) and fill in to match .env.
#
# Podman Quadlet .container units cannot interpolate ${VARS} across files the
# way compose.yml does, so the app container's *container-facing* POSTGRES_URL
# (hostname `memgrow-db`, not `localhost`) has to be spelled out here
# explicitly. Keep the user/password/db in sync with .env's
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
DB_PROVIDER=pg
POSTGRES_URL=postgresql://memgrow:change-me@memgrow-db:5432/memgrow
