    "dotenv": "^17.4.2",
    "lodash": "^4.18.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "openai": "^6.44.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.15",
    "react": "19.2.7",
    "react-apexcharts": "^2.1.1",
    "react-dom": "19.2.7",
    "sharp": "^0.34.5",
    "string-similarity-js": "^2.1.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
